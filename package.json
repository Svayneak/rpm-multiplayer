    "./TabletopStateManager": "./src/TabletopStateManager.js",
    "./PriorityStateMachine": "./src/PriorityStateMachine.js",
    "./StackAlarmManager": "./src/StackAlarmManager.js",
    "./DualChannelChat": "./src/DualChannelChat.js",
    "./ActionLexer": "./src/ActionLexer.js",
    "./SpeechRecognitionService": "./src/SpeechRecognitionService.js",
    "./TabletopUI": "./src/view/TabletopUI.js",
    "./CardOverlayModal": "./src/view/CardOverlayModal.js",
    "./tabletop.css": "./src/view/tabletop.css",
    "./relay": "./src/relay.js",
    "./RelayClient": "./src/RelayClient.js",
    "./PerkCatalog": "./src/PerkCatalog.js",
    "./RandomPerkEngine": "./src/RandomPerkEngine.js",
