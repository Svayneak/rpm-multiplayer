    "test:zone": "node test/test_zone_state.js",
    "test:priority": "node test/test_priority_stack.js",
    "test:chat": "node test/test_dual_chat_action.js",
    "test:ui": "node test/test_tabletop_ui.js",
    "test:relay": "node test/test_relay_sync.js",
    "test:perk": "node test/test_random_perk.js",
    "test:deckai": "node test/test_deckbuilder_ai.js",
    "test:fanfare": "node test/test_victory_fanfare.js",
